# core.autocrlf=true rewrites line endings on checkout. The fixture ratchet
# in tests/check_fixtures_deterministic.py sha256s these files, so any
# rewrite makes a fresh clone fail against a baseline recorded elsewhere.
# -text pins the bytes exactly as committed.
fixtures/** -text
tests/baseline.json -text

# Lockfiles are compared verbatim; never normalize them either.
sidecar/uv.lock -text
src-tauri/Cargo.lock -text
package-lock.json -text

# Hand-authored, never generated. The 401 body and the 500 HTML are asserted
# verbatim, so a line-ending rewrite changes what the AC-8 check compares.
fixtures/provider/** -text
graphify-out/graph.json merge=graphify

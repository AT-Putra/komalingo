# Secrets / local dev config -- never committed.
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
sidecar/.venv/
dist/
# build/ holds the committed PyInstaller sources (sidecar.spec,
# longpath.manifest, launch.py) AND runtime output (work/, dist/) that
# must never be committed. A bare "build/" ignore would swallow the
# sources too, so both are named.
build/work/
build/dist/
build/*.png

# Node / Tauri
node_modules/
src-tauri/target/

# Generated fixtures are reproducible from tests/gen_fixtures.py, but the
# real-panel sets are licensed source material and stay out of the repo.
# Image GLOBS, not wholesale directories: the hand-authored ground truth
# beside them (tategaki/expected.json, id/reference.json) IS committed, and
# ignoring the directory would take it with them. Neither JSON contains
# third-party artwork; fixtures/id/ holds no images at all.
fixtures/tategaki/**/*.png
fixtures/tategaki/**/*.jpg
fixtures/tategaki/**/*.jpeg
fixtures/tategaki/**/*.webp
fixtures/zh/**/*.png
fixtures/zh/**/*.jpg
fixtures/zh/**/*.jpeg
fixtures/zh/**/*.webp
fixtures/ko/**/*.png
fixtures/ko/**/*.jpg
fixtures/ko/**/*.jpeg
fixtures/ko/**/*.webp
fixtures/real/
# Phase 6 archive fixtures that are regenerable in seconds and have no business
# in git history: 200 pages, 5001 members, and 8MB of zeros. Every other
# fixtures/archives/ file is committed because they are small and the safety
# gate reads them in CI -- benign.cbr included, and it is now GENERATED like
# the rest (gen_fixtures._rar4_store) rather than an unauthorable binary.
fixtures/archives/big.cbz
fixtures/archives/members.cbz
fixtures/archives/bomb.cbz
fixtures/archives/bomb.cbt
fixtures/archives/bomb.cb7

src-tauri/binaries/*.exe
# The one-dir sidecar's payload, copied beside the exe (see binaries/README.md).
src-tauri/binaries/_internal/

# graphify: the graph itself is committed (graph.json, GRAPH_REPORT.md,
# graph.html, manifest.json, community labels). Machine-local churn is not:
# the content-addressed cache, the dated pre-rebuild backups, and the absolute
# scan-root path are per-clone, not per-repo.
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/.graphify_root
graphify-out/.graphify_python
graphify-out/.graphify_detect.json
graphify-out/.graphify_analysis.json
.sabotage-active
# Fetched by sidecar/native.py with pinned sha256s, never committed: nine
# native DLLs are 4MB that git history cannot give back, and a pin can be
# re-pinned. See sidecar/native.py for why conda-forge and why no-ICU.
build/libarchive/

# Secrets / local dev config -- never committed.
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
sidecar/.venv/
dist/
# build/ holds the committed PyInstaller sources (sidecar.spec,
# longpath.manifest, launch.py) AND runtime output (work/, dist/) that
# must never be committed. A bare "build/" ignore would swallow the
# sources too, so both are named.
build/work/
build/dist/
build/*.png

# Node / Tauri
node_modules/
src-tauri/target/

# Generated fixtures are reproducible from tests/gen_fixtures.py, but the
# real-panel sets are licensed source material and stay out of the repo.
fixtures/tategaki/
fixtures/real/
src-tauri/binaries/*.exe
